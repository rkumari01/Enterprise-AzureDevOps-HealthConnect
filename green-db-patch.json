{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "healthconnect-api",
            "env": [
              {
                "name": "DB_USERNAME",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "postgres-secret",
                    "key": "POSTGRES_USER"
                  }
                }
              },
              {
                "name": "DB_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "postgres-secret",
                    "key": "POSTGRES_PASSWORD"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
